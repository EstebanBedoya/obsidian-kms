# Variables de entorno para obsidian-kms (Dokploy → Environment).
# Copia este archivo, rellena los valores y pégalos en Dokploy. No subas valores reales.

# --- Obligatorias ---

# Usuario admin de CouchDB (lo usan también LiveSync y el MCP)
COUCHDB_USER=change-me

# Contraseña del admin de CouchDB. Generar: openssl rand -hex 32
COUCHDB_PASSWORD=change-me

# Token de acceso al MCP (Authorization: Bearer ...). Generar: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me

# Passphrase de cifrado E2E de LiveSync. Debe coincidir con la de cada cliente Obsidian.
# Generar: openssl rand -base64 33 | tr -d '\n/+=' | cut -c1-40
COUCHDB_PASSPHRASE=change-me

# --- Opcionales (valores por defecto del compose) ---

# Nombre de la base de datos en CouchDB
COUCHDB_DATABASE=obsidiannotes

# Nombre del vault; debe ser igual al del vault de Obsidian
VAULT_NAME=Notas
